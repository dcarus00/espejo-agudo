# ============================================================
# Espejo Agudo - Configuración (copiar a .env y completar)
# ============================================================

# Token del bot de Telegram (obtenerlo con @BotFather).
TELEGRAM_TOKEN=pegar_token_de_botfather_aqui

# ------------------------------------------------------------
# CONTROL DE ACCESO (recomendado: configurar siempre)
# Quién puede hablarle al espejo. Si queda vacío, el bot le
# responde a CUALQUIERA que lo encuentre (no recomendado).
# ------------------------------------------------------------

# IDs numéricos de Telegram autorizados, separados por comas.
# Tu ID lo obtenés hablándole a @userinfobot en Telegram.
# Ejemplo: ALLOWED_TELEGRAM_IDS=123456789,987654321
ALLOWED_TELEGRAM_IDS=

# Números de WhatsApp autorizados, separados por comas.
# Formato: codigo_pais + numero + "@c.us" (sin "+", sin espacios).
# Ejemplo: ALLOWED_WHATSAPP_NUMBERS=59899123456@c.us
ALLOWED_WHATSAPP_NUMBERS=

# Archivo con el system prompt (personalidad + tu contexto personal).
# Copiar el de ejemplo y editarlo: cp system_prompt.example.md system_prompt.md
SYSTEM_PROMPT_FILE=system_prompt.md

# URL de la API de Ollama (endpoint /api/generate).
OLLAMA_URL=http://localhost:11434/api/generate

# Modelo de Ollama a usar (no cambiar salvo que sepas lo que hacés).
OLLAMA_MODEL=qwen2.5:14b

# Host y puerto de Qdrant (memoria vectorial, vía Docker).
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Nombre de la colección en Qdrant.
COLLECTION_NAME=espejo_agudo

# Modelo de Whisper para transcripción local (tiny, base, small, medium).
WHISPER_MODEL=small

# URL del endpoint /send del bridge de WhatsApp (Node.js).
WHATSAPP_BRIDGE_URL=http://localhost:3000/send

# Ventana horaria (hora local) para mensajes proactivos.
HORA_INICIO=9
HORA_FIN=21
